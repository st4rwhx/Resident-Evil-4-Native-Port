# NEVER commit the original game data. This repo must only ever contain
# tooling + reconstructed source, never Capcom's copyrighted assets/binary.
*.iso
*.gcm
*.gcz
*.rvz
*.dol
*.rel
*.lfs
*.udas
*.das
/orig/
/baserom*/
/assets/

# Build artifacts
/build/*
!/build/.gitkeep

# Toolchain downloads (Ghidra, wibo, CodeWarrior, decomp-toolkit binaries,
# cloned extension repos) - but keep our own hand-written scripts
/tools/*
!/tools/.gitkeep
!/tools/scripts/
/tools/scripts/*.txt

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
